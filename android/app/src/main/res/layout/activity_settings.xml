<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vsBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/vsToolbarBg"
        app:navigationIconTint="?attr/vsToolbarText"
        app:title="@string/settings"
        app:titleTextColor="?attr/vsToolbarText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_account" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/username">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/host"
                app:helperText="@string/host_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_theme" />

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/themeClassic"
                    style="@style/SettingSwitch"
                    android:text="@string/theme_classic" />

                <TextView
                    style="@style/SettingDesc"
                    android:layout_marginStart="32dp"
                    android:text="@string/theme_classic_desc" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/themeTelegram"
                    style="@style/SettingSwitch"
                    android:text="@string/theme_telegram" />

                <TextView
                    style="@style/SettingDesc"
                    android:layout_marginStart="32dp"
                    android:text="@string/theme_telegram_desc" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/themeTerminal"
                    style="@style/SettingSwitch"
                    android:text="@string/theme_terminal" />

                <TextView
                    style="@style/SettingDesc"
                    android:layout_marginStart="32dp"
                    android:text="@string/theme_terminal_desc" />
            </RadioGroup>

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_notifications" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchStatusIcon"
                style="@style/SettingSwitch"
                android:text="@string/status_icon" />

            <TextView
                style="@style/SettingDesc"
                android:text="@string/status_icon_desc" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReminder"
                style="@style/SettingSwitch"
                android:text="@string/reminder" />

            <TextView
                style="@style/SettingDesc"
                android:text="@string/reminder_desc" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_experimental"
                android:textColor="?attr/vsWarn" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoOff"
                style="@style/SettingSwitch"
                android:text="@string/auto_off" />

            <TextView
                style="@style/SettingDesc"
                android:text="@string/auto_off_desc" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_about" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/vsText"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/author"
                android:textColor="?attr/vsTextSecondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/github"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/github" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:text="@string/save"
        android:textSize="16sp"
        app:cornerRadius="?attr/vsRadius" />
</LinearLayout>
